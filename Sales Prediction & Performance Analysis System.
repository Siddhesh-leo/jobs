import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression

df = pd.read_csv("sales_prediction_dataset_50_records.csv")

df["Month"] = pd.to_datetime(df["Month"])
df["Sales"] = pd.to_numeric(df["Sales"])

df = df.sort_values("Month").reset_index(drop=True)

total_sales = df["Sales"].sum()
average_sales = df["Sales"].mean()

best_month = df.loc[df["Sales"].idxmax()]
lowest_month = df.loc[df["Sales"].idxmin()]

print("\n--- SALES PERFORMANCE ANALYSIS ---")
print("Total Sales:", total_sales)
print("Average Monthly Sales:", round(average_sales, 2))

print("Best Month:",
      best_month["Month"].strftime("%B %Y"),
      best_month["Sales"])

print("Lowest Month:",
      lowest_month["Month"].strftime("%B %Y"),
      lowest_month["Sales"])

df["Growth"] = df["Sales"].pct_change() * 100

print("\n--- MONTHLY SALES GROWTH ---")
print(df[["Month", "Sales", "Growth"]])

X = np.arange(len(df)).reshape(-1, 1)
y = df["Sales"].values

model = LinearRegression()
model.fit(X, y)

future_X = np.arange(
    len(df), len(df) + 3
).reshape(-1, 1)

predictions = model.predict(future_X)
predictions = np.maximum(predictions, 0)

future_months = pd.date_range(
    start=df["Month"].iloc[-1] + pd.offsets.MonthBegin(1),
    periods=3,
    freq="MS"
)

print("\n--- NEXT 3 MONTHS SALES PREDICTION ---")

for month, sales in zip(future_months, predictions):
    print(month.strftime("%B %Y"), ":", round(sales, 2))

plt.figure(figsize=(12, 6))

plt.plot(
    df["Month"],
    df["Sales"],
    marker="o",
    label="Actual Sales"
)

plt.plot(
    future_months,
    predictions,
    marker="o",
    linestyle="--",
    color="red",
    label="Predicted Sales"
)

plt.title("Sales Prediction and Performance Analysis")
plt.xlabel("Month")
plt.ylabel("Sales Revenue")
plt.legend()
plt.grid(True)
plt.tight_layout()

plt.savefig("sales_prediction_chart.png")
plt.show()

forecast = pd.DataFrame({
    "Month": future_months,
    "Predicted_Sales": predictions
})

forecast.to_csv("sales_forecast.csv", index=False)

print("\nForecast saved successfully!")
print("File: sales_forecast.csv")
